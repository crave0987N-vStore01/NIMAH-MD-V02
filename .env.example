# Copy to .env and fill in (never commit .env)
OPENROUTER_API_KEY=
# Optional
# SELF_URL=https://your-app.up.railway.app   (self-ping so the host never sleeps)
# MAX_RSS_MB=900                              (auto-restart if memory passes this)
# AD_CARD=on                                  (link-card header on replies; off to disable)
# Chama API (api.chamindu.site) - powers .ytmp3
CHAMA_API_KEY=
# Multi-bot capacity
# MAX_BOTS=60            (max paired + waiting sessions on this server)
# MEM_LIMIT_MB=          (auto-detected from the container; set to override)
# BACKUP_SECRET=some-long-random-text   (encrypts the session backup in Firestore)
# ADMIN_PASSWORD=choose-a-strong-password   (protects /admin and /studio)
# OWNER_ALERTS=on        (WhatsApp alerts to OWNER_NUMBER when a bot logs out / goes offline)
# BOOT_ALERT=on          (a short notice when the server starts)
# YT_SEARCH_INSTANCES=piped:https://pipedapi.kavin.rocks,invidious:https://yewtu.be   (backup YouTube search servers)

# ❤️ GF mode: her number(s), comma separated, with country code (optional - you can also use the .gf command)
# GF_NUMBERS=947XXXXXXXX
